# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cropcast?retryWrites=true&w=majority
MONGO_DB_NAME=cropcast

# Clerk Authentication - Server Side Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Clerk Authentication - Frontend Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Frontend API Base URL (Leave empty for single-service deployment to use relative /api paths)
VITE_API_URL=
