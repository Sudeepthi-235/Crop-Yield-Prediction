# MongoDB connection string (use MongoDB Atlas free tier for hosting)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Any long random string, e.g. generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# Your deployed frontend URL(s), comma-separated if more than one
FRONTEND_URL=https://your-frontend.vercel.app

# Your deployed ML model service URL (include /predict)
ML_API_URL=https://your-ml-service.onrender.com/predict

# Set to "production" on Render
NODE_ENV=production
